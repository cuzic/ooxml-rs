from __future__ import annotations

from pathlib import Path

class Workbook:
    @staticmethod
    def open(path: str | Path) -> Workbook: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> Workbook: ...
    @staticmethod
    def new() -> Workbook: ...
    def save(self, path: str | Path) -> None: ...
    def to_bytes(self) -> bytes: ...
    def sheet_names(self) -> list[str]: ...
    # __inject_fault exists on fault-injection test builds only; tests reach
    # it through getattr.

class Document:
    @staticmethod
    def open(path: str | Path) -> Document: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> Document: ...
    def save(self, path: str | Path) -> None: ...
    def to_bytes(self) -> bytes: ...

class Presentation:
    @staticmethod
    def open(path: str | Path) -> Presentation: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> Presentation: ...
    def save(self, path: str | Path) -> None: ...
    def to_bytes(self) -> bytes: ...

def native_version() -> str: ...
def __kinds() -> dict[str, list[str]]: ...
def __table_keys() -> list[tuple[str, str]]: ...
