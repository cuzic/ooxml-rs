from __future__ import annotations

from pathlib import Path
from typing import Any, Literal, overload

class Workbook:
    @staticmethod
    def open(path: str | Path) -> Workbook: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> Workbook: ...
    @staticmethod
    def new() -> Workbook: ...
    def save(self, path: str | Path) -> None: ...
    def to_bytes(self) -> bytes: ...
    def sheet_names(self) -> list[str]: ...
    # __inject_fault exists on fault-injection test builds only; tests reach
    # it through getattr.

class Document:
    @staticmethod
    def open(path: str | Path) -> Document: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> Document: ...
    def save(self, path: str | Path) -> None: ...
    def to_bytes(self) -> bytes: ...
    def paragraph_texts(self) -> list[str]: ...
    def append_paragraph(self, text: str) -> int: ...
    @overload
    def replace(self, needle: str, replacement: str, *, on_refused: Literal["refuse"] = ...) -> int: ...
    @overload
    def replace(self, needle: str, replacement: str, *, on_refused: Literal["skip"]) -> tuple[int, list[dict[str, Any]]]: ...
    @overload
    def replace_many(self, pairs: list[tuple[str, str]], *, on_refused: Literal["refuse"] = ...) -> int: ...
    @overload
    def replace_many(self, pairs: list[tuple[str, str]], *, on_refused: Literal["skip"]) -> tuple[int, list[dict[str, Any]]]: ...

class Presentation:
    @staticmethod
    def open(path: str | Path) -> Presentation: ...
    @staticmethod
    def from_bytes(bytes: bytes) -> Presentation: ...
    def save(self, path: str | Path) -> None: ...
    def to_bytes(self) -> bytes: ...
    def slide_texts(self) -> list[str]: ...
    def replace_all(self, pattern: str, replacement: str) -> int: ...
    def add_slide(self, layout_index: int, at: int | None = ...) -> int: ...
    def delete_slide(self, index: int) -> None: ...
    def move_slide(self, from_index: int, to: int) -> None: ...
    def duplicate_slide(self, index: int, at: int | None = ...) -> int: ...

def native_version() -> str: ...
def __kinds() -> dict[str, list[str]]: ...
def __table_keys() -> list[tuple[str, str]]: ...
def __raise(crate: str, kind: str) -> None: ...
